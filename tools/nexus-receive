#!/usr/bin/env python3
"""Receive one nexus attachment over the authenticated SSH connection."""
import json
import os
from pathlib import Path
import socket
import subprocess
import sys

MAX_BYTES = 32 * 1024 * 1024


def receive(stream, server):
    def field():
        line = stream.readline(1024)
        if not line.endswith(b"\n"):
            raise ValueError("invalid attachment header")
        return line[:-1].decode("utf-8")
    friend, instance, name, size = field(), field(), field(), int(field())
    if (not isinstance(name, str) or name in ("", ".", "..") or len(name.encode()) > 255
            or any(ord(c) < 32 or c in "/\\\x7f" for c in name)):
        raise ValueError("invalid attachment filename")
    if type(size) is not int or not 0 <= size <= MAX_BYTES:
        raise ValueError("attachment exceeds the 32 MiB limit")
    data = subprocess.check_output(["git", "-C", str(server / "nexus-config"), "show", "HEAD:friends.json"])
    roster = json.loads(data)["friends"]
    owner = next((f for f in roster if f["name"] == friend), {})
    location = next((i for i in owner.get("instances", []) if i["name"] == instance), None)
    hosts = {socket.gethostname().lower(), socket.gethostname().split(".")[0].lower()}
    if (server / "config").exists():
        for line in (server / "config").read_text().splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[0] == "machine":
                hosts.add(parts[1].lower())
    if not location or location["machine"].lower() not in hosts:
        raise ValueError("the selected friend instance has no working directory on this server")
    # Hold the incoming directory by descriptor. The friend may rename files while we receive.
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    working = Path(location["dir"])
    if not working.is_absolute() or ".." in working.parts:
        raise ValueError("the configured working directory must be absolute")
    root = os.open("/", flags)
    try:
        for component in working.parts[1:]:
            child = os.open(component, flags, dir_fd=root)
            os.close(root)
            root = child
    except BaseException:
        os.close(root)
        raise
    try:
        try:
            os.mkdir("incoming", 0o700, dir_fd=root)
        except FileExistsError:
            pass
        incoming = os.open("incoming", flags, dir_fd=root)
    finally:
        os.close(root)
    try:
        folder = os.urandom(12).hex()
        os.mkdir(folder, 0o700, dir_fd=incoming)
        dest = os.open(folder, flags, dir_fd=incoming)
        try:
            temp = ".upload-" + os.urandom(12).hex()
            try:
                with os.fdopen(os.open(temp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600, dir_fd=dest), "wb") as out:
                    remaining = size
                    while remaining:
                        chunk = stream.read(min(remaining, 65536))
                        if not chunk:
                            raise ValueError("incomplete attachment")
                        out.write(chunk)
                        remaining -= len(chunk)
                    if stream.read(1):
                        raise ValueError("unexpected extra attachment bytes")
                    out.flush()
                    os.fsync(out.fileno())
                os.rename(temp, name, src_dir_fd=dest, dst_dir_fd=dest)
            finally:
                try:
                    os.unlink(temp, dir_fd=dest)
                except FileNotFoundError:
                    pass
        except BaseException:
            os.rmdir(folder, dir_fd=incoming)
            raise
        finally:
            os.close(dest)
    finally:
        os.close(incoming)
    return "incoming/" + folder + "/" + name


if __name__ == "__main__":
    try:
        print(receive(sys.stdin.buffer, Path.home() / ".nexus/server"))
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit("nexus-receive: " + str(error))
