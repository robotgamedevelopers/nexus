#!/usr/bin/env python3
"""Install a sealed macOS client at its existing path while its window stays open."""
import argparse
import ctypes
import os
from pathlib import Path
import subprocess
import tempfile

IDENTIFIER = "com.robotgamedevelopers.nexus"


def checked(*args):
    return subprocess.run(args, check=True, capture_output=True, text=True)


def verify(app):
    checked("/usr/bin/codesign", "--verify", "--deep", "--strict", app)
    checked("/usr/bin/codesign", "--verify", "-R", f'=identifier "{IDENTIFIER}"', app)


def same_signer(installed, staged):
    description = checked("/usr/bin/codesign", "-dv", "--verbose=4", installed).stderr.splitlines()
    if "Signature=adhoc" in description:
        return
    rules = checked("/usr/bin/codesign", "-d", "-r-", installed).stderr.splitlines()
    requirement = next((line.partition(" => ")[2] for line in rules if line.startswith("designated => ")), "")
    if not requirement:
        raise ValueError("could not read the installed client's signing requirement")
    checked("/usr/bin/codesign", "--verify", "-R", "=" + requirement, staged)


def install(source, destination):
    if destination.is_symlink() or source.resolve() == destination.resolve():
        raise ValueError("choose a separate application directory as the install destination")
    if destination.suffix != ".app" or not source.is_dir():
        raise ValueError("expected a built .app and a destination .app")
    with tempfile.TemporaryDirectory(prefix=".nexus-install-", dir=destination.parent) as temp:
        staged = Path(temp) / "nexus.app"
        checked("/usr/bin/ditto", source, staged)
        verify(staged)
        if not destination.exists():
            staged.rename(destination)
            return
        verify(destination)
        same_signer(destination, staged)
        # Both directory entries live on the same volume. A failed swap leaves the old client in place.
        libc = ctypes.CDLL(None, use_errno=True)
        rename = libc.renamex_np
        rename.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
        if rename(os.fsencode(staged), os.fsencode(destination), 0x2):
            error = ctypes.get_errno()
            raise OSError(error, os.strerror(error))


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path)
    parser.add_argument("destination", type=Path)
    args = parser.parse_args()
    try:
        install(args.source, args.destination)
    except subprocess.CalledProcessError as exc:
        parser.exit(1, exc.stderr or str(exc))
    except (OSError, ValueError) as exc:
        parser.exit(1, f"{exc}\n")
    print(f"Installed {args.destination}")
