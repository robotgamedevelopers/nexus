file(REMOVE_RECURSE "${ROOT}")
file(MAKE_DIRECTORY "${ROOT}/rules")
file(WRITE "${ROOT}/rules/client.star" "load(\"shared.star\", \"choice\")\ndef decide(event, ctx, config):\n    return choice(config, event)\n")
file(COPY_FILE "${ROOT}/rules/client.star" "${ROOT}/rules/server.star")
file(WRITE "${ROOT}/rules/shared.star" "def choice(config, event):\n    return config[event]\n")
foreach(revision IN ITEMS edit invalid)
    if(revision STREQUAL edit)
        file(WRITE "${ROOT}/rules/config.json" "{\"text_zoom\":3,\"account_after_limit\":\"c\"}")
    else()
        file(WRITE "${ROOT}/rules/config.json" "{\"text_zoom\":99,\"account_after_limit\":\"offline\"}")
    endif()
    foreach(side IN ITEMS client server)
        file(MAKE_DIRECTORY "${ROOT}/${revision}/${side}")
        execute_process(COMMAND "${TOOL}" apply ${side} "${ROOT}/rules" "${ROOT}/${revision}/${side}"
            COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
endforeach()
file(READ "${ROOT}/edit/client/policy.bundle.json" before)
file(WRITE "${ROOT}/rules/shared.star" "load(\"client.star\", \"decide\")\n")
execute_process(COMMAND "${TOOL}" apply client "${ROOT}/rules" "${ROOT}/edit/client" RESULT_VARIABLE status)
file(READ "${ROOT}/edit/client/policy.bundle.json" after)
if(status EQUAL 0 OR NOT before STREQUAL after)
    message(FATAL_ERROR "a cyclic import replaced the active client bundle")
endif()
execute_process(COMMAND "${CHECK}" "${ROOT}" COMMAND_ERROR_IS_FATAL ANY)
