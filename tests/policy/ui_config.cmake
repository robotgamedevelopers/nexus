file(REMOVE_RECURSE "${ROOT}")
file(MAKE_DIRECTORY "${ROOT}/rules" "${ROOT}/active" "${ROOT}/disabled")
file(COPY "${RULES}/" DESTINATION "${ROOT}/rules")
file(READ "${RULES}/config.json" config)
string(JSON config SET "${config}" ui_style body_size 30)
string(JSON config SET "${config}" ui_style bubble_padding_x 12)
string(JSON config SET "${config}" ui_style entry_gap 22)
string(JSON config SET "${config}" ui_colors background [["#102030"]])
string(JSON config SET "${config}" ui_text server_title [["Choose a host"]])
string(JSON config SET "${config}" ui_keys submit [["Command+S"]])
string(JSON config SET "${config}" transcript_style panel_fill [["#304050"]])
string(JSON config SET "${config}" transcript_style goal_label [["Persistent task"]])
string(JSON config SET "${config}" transcript_style goal_outline_width 6)
string(JSON config SET "${config}" transcript_style tool_chevron false)
string(JSON config SET "${config}" transcript_style tool_inks Edit [["#9876ab"]])
file(WRITE "${ROOT}/rules/config.json" "${config}")
execute_process(COMMAND "${TOOL}" apply client "${ROOT}/rules" "${ROOT}/active" COMMAND_ERROR_IS_FATAL ANY)
string(JSON config SET "${config}" transcript_style idle_animations false)
string(JSON config SET "${config}" clock visible false)
string(JSON config SET "${config}" ui_flags notch_aware false)
file(WRITE "${ROOT}/rules/config.json" "${config}")
execute_process(COMMAND "${TOOL}" apply client "${ROOT}/rules" "${ROOT}/disabled" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CHECK}" --ui-config "${ROOT}/active/policy.bundle.json" "${ROOT}/disabled/policy.bundle.json" COMMAND_ERROR_IS_FATAL ANY)
