# A single source for shipped UI defaults, including native fallback values.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/policy/rules/config.json")
file(READ "${PROJECT_SOURCE_DIR}/policy/rules/config.json" ui_json)
set(ui_defaults "// Generated from policy/rules/config.json; do not edit.\n")
foreach(section IN ITEMS style colors text keys flags fonts scroll)
    string(TOUPPER "${section}" macro)
    string(APPEND ui_defaults "#ifdef NEXUS_UI_${macro}\n")
    string(JSON count LENGTH "${ui_json}" "ui_${section}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON key MEMBER "${ui_json}" "ui_${section}" ${index})
        string(JSON value GET "${ui_json}" "ui_${section}" "${key}")
        if(section STREQUAL "colors")
            string(REPLACE "#" "0x" value "${value}")
        elseif(section STREQUAL "flags")
            if(value)
                set(value true)
            else()
                set(value false)
            endif()
        elseif(NOT section STREQUAL "style" AND NOT section STREQUAL "scroll")
            string(REPLACE "\\" "\\\\" value "${value}")
            string(REPLACE "\"" "\\\"" value "${value}")
            string(REPLACE "\n" "\\n" value "${value}")
            set(value "\"${value}\"")
        endif()
        string(APPEND ui_defaults "NEXUS_UI_${macro}(${key}, ${value})\n")
    endforeach()
    string(APPEND ui_defaults "#endif\n")
endforeach()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/nexus_ui_defaults.inc.tmp" "${ui_defaults}")
configure_file("${CMAKE_CURRENT_BINARY_DIR}/generated/nexus_ui_defaults.inc.tmp"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/nexus_ui_defaults.inc" COPYONLY)
file(REMOVE "${CMAKE_CURRENT_BINARY_DIR}/generated/nexus_ui_defaults.inc.tmp")
