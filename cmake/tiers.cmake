# Each test's tier, as one more label (docs/ci-tiers.md): tier_pr, run by every pull request, or tier_nightly, run by
# the nightly; every test gets exactly one. A unit test is tier_pr and any other test tier_nightly, unless
# tests/tiers.txt moves it: a row there is `<test> <pr|nightly> <condition>`, where <condition> is the CMake variables
# (joined with +) that are all true wherever the test is registered, or ALWAYS. A row whose condition holds but whose
# test this build does not register fails the configure, and so does a malformed row, a second row for one test, or a
# test that already carries a tier label: a test the table names cannot quietly drop out of its tier.
#
# The top-level CMakeLists.txt includes this after its last test; nexus_test_tiers() runs at the end of its configure.

# The table; the planted cases (.github/tiers-selftest.sh) give their own.
if(NOT DEFINED NEXUS_TIERS_TABLE)
    set(NEXUS_TIERS_TABLE "${CMAKE_CURRENT_LIST_DIR}/../tests/tiers.txt")
endif()

# Every test registered in <dir> and below, as <dir>|<name>.
function(nexus_tiers_collect dir out)
    get_property(tests DIRECTORY "${dir}" PROPERTY TESTS)
    set(found "")
    foreach(test IN LISTS tests)
        list(APPEND found "${dir}|${test}")
    endforeach()
    get_property(subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
    foreach(sub IN LISTS subdirs)
        nexus_tiers_collect("${sub}" more)
        list(APPEND found ${more})
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(nexus_test_tiers)
    nexus_tiers_collect("${PROJECT_SOURCE_DIR}" entries)
    set(names "")
    foreach(entry IN LISTS entries)
        string(REGEX MATCH "[^|]*$" name "${entry}")
        list(APPEND names "${name}")
    endforeach()

    file(STRINGS "${NEXUS_TIERS_TABLE}" rows)
    set(moved "")
    foreach(row IN LISTS rows)
        string(REGEX REPLACE "#.*$" "" row "${row}")
        string(STRIP "${row}" row)
        if(row STREQUAL "")
            continue()
        endif()
        string(REGEX REPLACE "[ \t]+" ";" fields "${row}")
        list(LENGTH fields count)
        if(NOT count EQUAL 3)
            message(FATAL_ERROR "tests/tiers.txt: expected `<test> <pr|nightly> <condition>`, got: ${row}")
        endif()
        list(GET fields 0 name)
        list(GET fields 1 tier)
        list(GET fields 2 condition)
        if(NOT tier MATCHES "^(pr|nightly)$")
            message(FATAL_ERROR "tests/tiers.txt: ${name}'s tier is ${tier}, not pr or nightly")
        endif()
        if(name IN_LIST moved)
            message(FATAL_ERROR "tests/tiers.txt: ${name} has a second row")
        endif()
        set(holds TRUE)
        if(NOT condition STREQUAL "ALWAYS")
            string(REPLACE "+" ";" variables "${condition}")
            foreach(variable IN LISTS variables)
                if(NOT ${variable})
                    set(holds FALSE)
                endif()
            endforeach()
        endif()
        if(NOT holds)
            continue()
        endif()
        if(NOT name IN_LIST names)
            message(FATAL_ERROR "tests/tiers.txt: ${name} (${tier}, where ${condition}) is not a test of this build")
        endif()
        list(APPEND moved "${name}")
        set(tier_of_${name} "${tier}")
    endforeach()

    set(pr 0)
    set(nightly 0)
    foreach(entry IN LISTS entries)
        string(REGEX MATCH "^[^|]*" dir "${entry}")
        string(REGEX MATCH "[^|]*$" name "${entry}")
        get_property(labels TEST "${name}" DIRECTORY "${dir}" PROPERTY LABELS)
        if("tier_pr" IN_LIST labels OR "tier_nightly" IN_LIST labels)
            message(FATAL_ERROR "${name} already has a tier label: tiers come from tests/tiers.txt alone")
        endif()
        if(DEFINED tier_of_${name})
            set(tier "${tier_of_${name}}")
        elseif("unit" IN_LIST labels)
            set(tier pr)
        else()
            set(tier nightly)
        endif()
        set_property(TEST "${name}" DIRECTORY "${dir}" APPEND PROPERTY LABELS "tier_${tier}")
        math(EXPR ${tier} "${${tier}} + 1")
    endforeach()
    message(STATUS "Test tiers: ${pr} on every pull request (tier_pr), ${nightly} in the nightly (tier_nightly)")
endfunction()

cmake_language(DEFER DIRECTORY "${PROJECT_SOURCE_DIR}" CALL nexus_test_tiers)
