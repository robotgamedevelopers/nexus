set(plugins "${APP}/Contents/PlugIns")
file(MAKE_DIRECTORY "${plugins}" "${APP}/Contents/Resources")
get_filename_component(name "${MODULE}" NAME)
file(GLOB previous "${plugins}/nexus-client-*.bundle")
foreach(old IN LISTS previous)
    if(NOT old STREQUAL "${plugins}/${name}")
        file(REMOVE "${old}")
    endif()
endforeach()
file(COPY_FILE "${MODULE}" "${plugins}/${name}")
file(COPY_FILE "${MARKER}" "${APP}/Contents/Resources/client-module.txt")
execute_process(COMMAND /usr/bin/codesign --force --sign "${IDENTITY}" "${plugins}/${name}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND /usr/bin/codesign --force --sign "${IDENTITY}" "${APP}" COMMAND_ERROR_IS_FATAL ANY)
