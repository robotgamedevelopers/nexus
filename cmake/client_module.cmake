# An open client owns all window and transport state. The module operates on its
# C++ objects, so a host or toolchain change requires a new process.
set(module_sources src/view.cpp src/frame_host.cpp src/client_module.cpp)
file(GLOB_RECURSE host_inputs CONFIGURE_DEPENDS RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}"
    "src/*.h" "src/*.cpp" "src/*.mm" "src/*.in" "src/*.inc" "cmake/*.cmake" "cmake/*.in" "schema/*" "policy/rules/*")
# FrameHost also runs resident callbacks outside the module's frame and event handlers.
list(REMOVE_ITEM host_inputs src/view.cpp src/client_module.cpp)
list(APPEND host_inputs CMakeLists.txt)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${host_inputs} ${module_sources})
set(abi_inputs "")
foreach(setting CMAKE_CXX_COMPILER_ID CMAKE_CXX_COMPILER_VERSION CMAKE_CXX_FLAGS CMAKE_OSX_SYSROOT
        CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_ARCHITECTURES CMAKE_SYSTEM_PROCESSOR
        NEXUS_LINK NEXUS_TEST_AUTHENTICATOR NEXUS_TAILSCALE NEXUS_LTO)
    string(APPEND abi_inputs ";${setting}=${${setting}}")
endforeach()
foreach(file IN LISTS host_inputs)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${file}" digest)
    string(APPEND abi_inputs ";${file}=${digest}")
endforeach()
set(module_inputs "")
foreach(file IN LISTS module_sources)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${file}" digest)
    string(APPEND module_inputs ";${digest}")
endforeach()
set(configs "${CMAKE_CONFIGURATION_TYPES}")
if(NOT configs)
    set(configs "${CMAKE_BUILD_TYPE}")
    if(NOT configs)
        set(configs NoConfig)
    endif()
endif()
set(module_version "")
foreach(config IN LISTS configs)
    set(folder "${config}")
    set(match "$<CONFIG:${config}>")
    if(config STREQUAL "NoConfig")
        set(folder "")
        set(match "1")
    endif()
    string(TOUPPER "${config}" upper)
    string(SHA256 nexus_client_abi "${abi_inputs};${config};${CMAKE_CXX_FLAGS_${upper}}")
    string(SHA256 revision "${nexus_client_abi};${module_inputs}")
    configure_file(cmake/client_module_version.h.in "generated/${folder}/client_module_version.h" @ONLY)
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/${folder}/client-module.txt"
        CONTENT "@nexus_client_abi@\n@revision@\n" @ONLY)
    string(APPEND module_version "$<${match}:${revision}>")
endforeach()
add_library(nexus_client_module MODULE ${module_sources})
target_link_libraries(nexus_client_module PRIVATE $<COMPILE_ONLY:nexus_frame>)
target_include_directories(nexus_client_module PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>")
target_compile_options(nexus_client_module PRIVATE ${NEXUS_WARNINGS})
target_link_options(nexus_client_module PRIVATE "LINKER:-undefined,dynamic_lookup" "LINKER:-exported_symbol,_nexusClientModule")
set_target_properties(nexus_client_module PROPERTIES PREFIX "" SUFFIX ".bundle" OUTPUT_NAME "nexus-client-${module_version}"
    CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
set_target_properties(nexus PROPERTIES ENABLE_EXPORTS YES)
target_sources(nexus PRIVATE src/client_reload.mm)
set_source_files_properties(src/client_reload.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
target_link_libraries(nexus PRIVATE "-framework Security")
target_include_directories(nexus BEFORE PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>")
set(signing_identity "${NEXUS_MAC_SIGN_IDENTITY}")
if(NOT signing_identity)
    set(signing_identity "-")
endif()
add_dependencies(nexus nexus_client_module)
set_property(TARGET nexus APPEND PROPERTY LINK_DEPENDS "$<TARGET_FILE:nexus_client_module>")
add_custom_command(TARGET nexus POST_BUILD
    COMMAND ${CMAKE_COMMAND} "-DAPP=$<TARGET_BUNDLE_DIR:nexus>" "-DMODULE=$<TARGET_FILE:nexus_client_module>"
        "-DMARKER=${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>/client-module.txt" "-DIDENTITY=${signing_identity}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/package_client_module.cmake"
    VERBATIM)
